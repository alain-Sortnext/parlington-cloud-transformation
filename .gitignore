# Parlington Ltd — .gitignore

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log
override.tf
override.tf.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
venv/
.venv/
dist/

# AWS credentials — NEVER commit these
.aws/
credentials
*.pem
*.key

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Reports (generated artifacts — commit to submissions/ instead)
inventory_report.json
cost_report.csv
compliance_report.json

# Secrets
*.secret
secrets/
.env.local
