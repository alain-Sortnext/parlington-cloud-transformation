{
  "_comment": "Parlington Ltd — IAM Password Policy",
  "_status": "REFERENCE — apply via Terraform in Phase 4",
  "_compliance": "ISO 27001 A.9.4.3, FCA SYSC 13.7",
  "MinimumPasswordLength": 14,
  "RequireUppercaseCharacters": true,
  "RequireLowercaseCharacters": true,
  "RequireNumbers": true,
  "RequireSymbols": true,
  "AllowUsersToChangePassword": true,
  "MaxPasswordAge": 90,
  "PasswordReusePrevention": 12,
  "HardExpiry": false,
  "_note": "FCA SYSC 13.7.2 requires firms to have documented password management controls"
}
